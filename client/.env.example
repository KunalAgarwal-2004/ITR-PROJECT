# Client Environment Configuration

# API base URL. Leave unset in development so requests go through the Vite proxy (/api -> http://localhost:5000),
# which keeps the session cookie same-origin. Set it only when the API is hosted elsewhere.
# VITE_API_URL=https://api.example.com/api

VITE_APP_NAME=WorkBridge
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Prices are stored in USD by the API and displayed in Indian Rupees using this fixed rate (default 83)
VITE_USD_TO_INR=83
