# ==========================================
# WorkBridge Freelance Marketplace Server
# Environment Configuration Template
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development

# Client URL (for CORS whitelisting)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local)
# Both MONGODB_URI and MONGO_URI are supported.

# Option A: MongoDB Atlas (SRV format)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.0i5fzj4.mongodb.net/freelance_marketplace?retryWrites=true&w=majority

# Option B: MongoDB Atlas (Standard Non-SRV format, bypasses local DNS SRV restrictions)
# MONGODB_URI=mongodb://<username>:<password>@ac-sji06ss-shard-00-00.0i5fzj4.mongodb.net:27017,ac-sji06ss-shard-00-01.0i5fzj4.mongodb.net:27017,ac-sji06ss-shard-00-02.0i5fzj4.mongodb.net:27017/freelance_marketplace?ssl=true&replicaSet=atlas-sji06ss-shard-0&authSource=admin&retryWrites=true&w=majority

# Option C: Local MongoDB Instance (offline development)
MONGODB_URI=mongodb://127.0.0.1:27017/freelance_marketplace

# JWT Authentication Secret (Minimum 32 characters in production)
JWT_SECRET=your_jwt_strong_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Cookie Security Secret
COOKIE_SECRET=your_cookie_signing_secret_here_min_32_characters

# Google OAuth Credentials (for SSO)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret